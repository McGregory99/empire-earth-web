; Exports of EEWebRasterizer.dll: the four plain C entry points the engine resolves with
; GetProcAddress in PIMModule::GetModule (and RPIMGetRasterizer in GEInitialize).  All are
; cdecl.  Ordinals are numbered alphabetically from 1, as the linker did for the original's
; plain exports (which sit at 252..255 behind its 251 mangled class exports).  The names are
; exported undecorated: the linker maps `PIMGetName` to the cdecl symbol `_PIMGetName`.
LIBRARY EEWebRasterizer
EXPORTS
    PIMGetName          @1
    PIMGetType          @2
    PIMIsValid          @3
    RPIMGetRasterizer   @4
; The screen registry and the private constructor of the screen class, under the decorated names the original
; exports them by: the test harness builds screens and reaches the live ones through them (the engine does not).
    ??0DX7Screen@@AAE@PAUHMONITOR__@@PAUIDirectDraw7@@ABVUString@@_N3@Z   @5
    ?GetScreen@DX7Screen@@SAPAV1@K@Z                                       @6
    ?GetScreenCount@DX7Screen@@SAKXZ                                       @7
; The projection set-up helpers of DX7Rasterizer (protected members there), under the original's decorated names, for the harness.
    ?Set2DMode@DX7Rasterizer@@IAEJK@Z=?Set2DMode@EEWebNullRasterizer@@AAEJK@Z                                                                  @8
    ?Set3DMode@DX7Rasterizer@@IAEJK@Z=?Set3DMode@EEWebNullRasterizer@@AAEJK@Z                                                                  @9
    ?ConvertToD3DMatrix@DX7Rasterizer@@IAEXABVGETransformation@@AAU_D3DMATRIX@@@Z=?ConvertToD3DMatrix@EEWebNullRasterizer@@AAEXABUGETransformationLayout@@PAM@Z   @10
