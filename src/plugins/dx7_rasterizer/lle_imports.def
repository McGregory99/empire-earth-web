; Import definition for the part of the original "Low-Level Engine.dll" that this plugin
; calls.  Names are the MSVC 6 decorated C++ names; see ../../engine_abi/low_level_engine.def
; for the larger list the TCP plugin uses.
LIBRARY "Low-Level Engine.dll"
EXPORTS
    ??0UString@@QAE@PBD@Z
    ??1UString@@UAE@XZ
    ??0UString@@QAE@ABV0@@Z
    ?ESRecordNativeError@@YAKK@Z
    ?GEPackColor@@YAKKABVGEColor@@M@Z
    ?GEPackColor@@YAKKKKKK@Z
    ?GEUnpackRed@@YAEKK@Z
    ?GEUnpackGreen@@YAEKK@Z
    ?GEUnpackBlue@@YAEKK@Z
    ?GEUnpackAlpha@@YAEKK@Z
    ?Dereference@UReferenceCounter@@QAEXXZ
    ??1GEWindow@@QAE@XZ
