# Scenario 3 of P2.4: the paused skirmish.
# The save is the user's (kept outside the repository, in ~/Games/EmpireEarth-re/scenarios); only its checksum is here.
SCN_NAME=skirmish-paused
SCN_ARGS='-loadgame "ee_p24_skirm1.ees"'
