# Paused skirmish with units selected: a selection box dragged over the middle of the view after the pause (selection rings and the unit panel).
# The save is the user's (kept outside the repository, in ~/Games/EmpireEarth-re/scenarios); only its checksum is here.
SCN_NAME=skirmish-selected
SCN_ARGS='-loadgame "ee_p24_skirm1.ees"'
SCN_SAVE=ee_p24_skirm1.ees
SCN_SAVE_SHA256=dce7741eb29f7dde374ff4357e863be6e6349deae44a3f14d96ebc7ed67e4d11
SCN_PRESENTS=60
SCN_ENV="EE_SIMHASH=1 EE_SIM_FIXED_MS=33"
SCN_KEYS="3d"
SCN_KEY_WINDOW="SSSI Empire Earth"
SCN_NORMALIZE=structure
SCN_SHOTS=3
SCN_SHOT_GAP=4
SCN_SETUP_ARGS="drag:0.30,0.35,0.70,0.65"
